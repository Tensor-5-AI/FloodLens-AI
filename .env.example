# ==============================================================================
# FloodLens AI — Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Application & API Settings
PROJECT_NAME="FloodLens AI"
ENVIRONMENT=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File & Data Storage Paths (relative to repository root or absolute)
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODEL_ARTIFACTS_DIR=./ml/artifacts

# Geospatial & Public Map Services (Optional / Future Integration)
# CESIUM_ION_TOKEN=your_cesium_ion_token_here
# MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json
